<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:padding="24dp"
    tools:context=".OpenActivity">

    <!-- Background shapes for visual appeal -->
    <View
        android:id="@+id/background_circle_1"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/circle_shape_light"
        android:alpha="0.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp" />

    <View
        android:id="@+id/background_circle_2"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/circle_shape_light"
        android:alpha="0.08"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="-40dp"
        android:layout_marginBottom="100dp" />

    <!-- Main content container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/main_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <!-- Logo Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#F8F9FA"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:padding="20dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/logo"/>

            </androidx.cardview.widget.CardView>

            <!-- App Title -->
            <TextView
                android:id="@+id/text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="SETOR"
                android:textColor="#2E7D32"
                android:textSize="42sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="Selamat datang di aplikasi SETOR"
                android:textColor="#666666"
                android:textSize="16sp"
                android:textAlignment="center"
                android:alpha="0.8" />

            <!-- Primary Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttondaftar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#4CAF50"
                android:text="Jelajahi Sekarang"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:cornerRadius="28dp"
                app:elevation="4dp"
                app:rippleColor="#81C784"
                app:strokeWidth="0dp"/>

            <!-- Secondary Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_info"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/transparent"
                android:text="Pelajari Lebih Lanjut"
                android:textSize="16sp"
                android:textColor="#4CAF50"
                app:cornerRadius="24dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="1dp"
                app:rippleColor="#E8F5E8" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Version info -->
    <TextView
        android:id="@+id/version_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Versi 1.0.0"
        android:textColor="#999999"
        android:textSize="12sp"
        android:alpha="0.6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>